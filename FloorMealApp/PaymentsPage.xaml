<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientLedgerApp.PaymentsPage"
             x:Name="RootPayPage"
             Title="Payments &amp; History">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Frame>
            <VerticalStackLayout>
                <Label Text="Summary" FontAttributes="Bold"/>
                <HorizontalStackLayout>
                    <Label Text="{Binding SummaryTotals, StringFormat='Total: ₹{0:N2}'}"/>
                    <Label Text="{Binding SummaryReceived, StringFormat='Received: ₹{0:N2}'}"/>
                    <Label Text="{Binding SummaryPending, StringFormat='Pending: ₹{0:N2}'}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>
        <CollectionView ItemsSource="{Binding Payments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="Red" Command="{Binding BindingContext.DeletePaymentCommand, Source={x:Reference Name=RootPayPage}}" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}"/>
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N2}'}"/>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>