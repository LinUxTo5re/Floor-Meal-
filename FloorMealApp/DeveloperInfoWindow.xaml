<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientLedgerApp.DeveloperInfoWindow"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">
    
    <!-- Semi-transparent overlay -->
    <Grid BackgroundColor="#80000000">
        
        <!-- Developer Info Container -->
        <Frame x:Name="InfoFrame"
               BackgroundColor="White"
               CornerRadius="25"
               HasShadow="True"
               Padding="0"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="350"
               MaximumWidthRequest="380">
            
            <StackLayout Spacing="0">
                
                <!-- Header with Gradient -->
                <Grid x:Name="HeaderGrid" 
                      HeightRequest="100">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <!-- Developer Icon -->
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="👨‍💻"
                               FontSize="32"
                               HorizontalOptions="Center" />
                        <Label Text="Developer Info"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
                
                <!-- Content Area -->
                <StackLayout Padding="30,25,30,30" Spacing="20">
                    
                    <!-- App Info -->
                    <StackLayout Spacing="8">
                        <Label Text="📱 App Information"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        
                        <Frame BackgroundColor="#F8F9FA" 
                               CornerRadius="12" 
                               Padding="15"
                               HasShadow="False">
                            <StackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🏷️" FontSize="16" />
                                    <Label Text="FloorMeal Client (FMC) v1.0"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#495057" />
                                </HorizontalStackLayout>
                                
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📅" FontSize="16" />
                                    <Label Text="Release: August 2025"
                                           FontSize="14"
                                           TextColor="#6C757D" />
                                </HorizontalStackLayout>
                                
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                    
                    <!-- Developer Contact -->
                    <StackLayout Spacing="8">
                        <Label Text="👨‍💻 Developer Contact"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        
                        <Frame BackgroundColor="#F8F9FA" 
                               CornerRadius="12" 
                               Padding="15"
                               HasShadow="False">
                            <StackLayout Spacing="12">
                                
                                <!-- GitHub -->
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🌐" FontSize="16" />
                                    <Label Text="GitHub:"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#495057" />
                                </HorizontalStackLayout>
                                <Label Text="https://github.com/LinUxTo5re"
                                       FontSize="13"
                                       TextColor="#0066CC"
                                       TextDecorations="Underline"
                                       Margin="26,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGitHubTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                
                                <!-- Email -->
                                <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                                    <Label Text="📧" FontSize="16" />
                                    <Label Text="Email:"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#495057" />
                                </HorizontalStackLayout>
                                <Label Text="dev.linuxto5re@gmail.com"
                                       FontSize="13"
                                       TextColor="#0066CC"
                                       TextDecorations="Underline"
                                       Margin="26,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmailTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                    
                    <!-- Support Message (shown when auto-opened) -->
                    <Frame x:Name="SupportFrame"
                           BackgroundColor="#FFF3CD" 
                           CornerRadius="12" 
                           Padding="15"
                           HasShadow="False"
                           IsVisible="False">
                        <StackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="⚠️" FontSize="16" />
                                <Label Text="Need Help?"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#856404" />
                            </HorizontalStackLayout>
                            <Label Text="If you're having trouble logging in or your account is inactive, please contact the developer using the information above."
                                   FontSize="12"
                                   TextColor="#856404"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                    
                    <!-- Close Button -->
                    <Button x:Name="CloseButton"
                            Text="✕ Close"
                            BackgroundColor="#6C757D"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="45"
                            FontSize="16"
                            FontAttributes="Bold"
                            Clicked="OnCloseClicked"
                            Margin="0,10,0,0" />
                    
                </StackLayout>
                
            </StackLayout>
            
        </Frame>
        
    </Grid>
    
</ContentPage>